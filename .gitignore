__pycache__/
*.pyc
*.pyo
.pytest_cache/
build/
dist/
*.spec.bak

# External tool binaries (mp3val.exe, keyfinder-cli.exe + its FFmpeg
# DLLs) -- README explains where to get them; never meant to be
# committed here, only bundled into a local build's tools\.
tools/*.exe
tools/*.dll

# Runtime-generated: written next to the app on first run (dev mode:
# the project root) via core.app_paths.base_dir() -- see core/settings.py.
mp3redactor_settings.ini

# Written next to the exe on an unhandled exception -- per-machine
# diagnostic output, not something to ship in the repo.
mp3redactor_crash.log

# Linux builds (redactor-build-tools/linux-build/build.sh)
build-linux/
dist-linux/

# File > Undo Last Rename's log (redactor_common's RenameLog) -- per-user data,
# next to the settings like mp3redactor_settings.ini.
mp3redactor_rename_log.json
